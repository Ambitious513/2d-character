{
  "name": "stride-character-kit",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Reusable, frame-deterministic 2D character library (cast, motions, lip-sync) and environments for Remotion, plus a live visual studio.",
  "_releaseChecklist": "Run `npm run update:visual-goldens` after an intentional visual change, and `npm run kit:zip` before cutting a release so public/stride-remotion-kit.zip matches the source tree.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts WalkScene renders/walk.mp4",
    "still": "remotion still src/remotion/index.ts WalkScene renders/character.png --frame=60",
    "render:cast": "remotion render src/remotion/index.ts CastScene renders/cast.mp4",
    "render:dialogue": "remotion render src/remotion/index.ts DialogueScene renders/dialogue.mp4",
    "render:alpha": "remotion render src/remotion/index.ts CharacterOnly renders/frames --image-format=png --sequence",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:watch": "tsx --test --watch tests/*.test.ts tests/*.test.tsx",
    "update:visual-goldens": "tsx scripts/update-visual-goldens.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:docs": "tsx scripts/docs-smoke.mts",
    "contact-sheet": "tsx scripts/contact-sheet.tsx",
    "verify": "npm run typecheck && npm test && npm run build",
    "scene-sheet": "tsx scripts/scene-sheet.tsx",
    "render:sheet": "remotion still src/remotion/index.ts CastSheet renders/cast-sheet.png --frame=30",
    "render:motions": "remotion still src/remotion/index.ts MotionSheet renders/motion-sheet.png --frame=45",
    "preview:kit": "npm run contact-sheet && npm run scene-sheet",
    "render:alpha:prores": "remotion render src/remotion/index.ts CharacterOnly renders/character.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:alpha:webm": "remotion render src/remotion/index.ts CharacterOnly renders/character.webm --codec=vp9 --pixel-format=yuva420p --image-format=png",
    "check:ids": "tsx scripts/check-ids.tsx",
    "check:env-ids": "tsx scripts/check-env-ids.tsx",
    "kit:zip": "tsx scripts/generate-kit-zip.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@remotion/cli": "^4.0.543",
    "@remotion/player": "^4.0.543",
    "@remotion/zod-types": "^4.0.543",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "^4.0.543",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}

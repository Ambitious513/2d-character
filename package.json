{"name": "stride-character-kit", "version": "2.0.0", "private": true, "type": "module", "description": "Reusable, frame-deterministic 2D characters and environments for Remotion, plus a live visual studio.", "scripts": {"dev": "vite --host 0.0.0.0", "build": "tsc -b && vite build", "preview": "vite preview --host 0.0.0.0", "typecheck": "tsc -b", "studio": "remotion studio src/remotion/index.ts", "render": "remotion render src/remotion/index.ts WalkScene renders/walk.mp4", "still": "remotion still src/remotion/index.ts WalkScene renders/character.png --frame=60", "render:cast": "remotion render src/remotion/index.ts CastScene renders/cast.mp4", "render:dialogue": "remotion render src/remotion/index.ts DialogueScene renders/dialogue.mp4", "render:alpha": "remotion render src/remotion/index.ts CharacterOnly renders/frames --image-format=png --sequence", "test": "tsx --test tests/*.test.ts", "test:watch": "tsx --test --watch tests/*.test.ts", "smoke": "node scripts/smoke.mjs", "contact-sheet": "tsx scripts/contact-sheet.tsx", "verify": "npm run typecheck && npm test && npm run build"}, "dependencies": {"@fontsource-variable/bricolage-grotesque": "^5.3.0", "@fontsource-variable/manrope": "^5.3.0", "@remotion/cli": "^4.0.543", "@remotion/player": "^4.0.543", "@remotion/zod-types": "^4.0.543", "fflate": "^0.8.2", "lucide-react": "^0.468.0", "react": "19.0.0", "react-dom": "19.0.0", "remotion": "^4.0.543", "zod": "4.6.7"}, "devDependencies": {"@playwright/test": "^1.65.1", "@types/node": "^22.10.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^4.3.4", "tsx": "^4.23.15", "typescript": "^5.7.2", "vite": "^6.1.0"}}